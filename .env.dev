# =============================================================================
# Translation Helps MCP — Dev Environment Configuration
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to git (it is gitignored).
# =============================================================================

# --- Node environment ---
NODE_ENV=development

# --- LLM generation (required for the chat UI) ---
OPENAI_API_KEY=sk-...your_openai_key_here...
ANTHROPIC_API_KEY=sk-ant-...your_anthropic_key_here...

# --- Caching ---
BUNDLE_CACHE_MAX_SIZE=500

# --- Cloudflare bindings (wrangler.toml injects these in CF env) ---
# CF KV namespace ID for TRANSLATION_HELPS_CACHE (set automatically by wrangler)
# CF R2 bucket name for ZIP_FILES (set automatically by wrangler)
