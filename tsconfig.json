{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "$core/*": ["./src/core/*"],
      "@translation-helps/door43": ["./packages/door43/src/index.ts"],
      "@translation-helps/door43/*": ["./packages/door43/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "packages/door43/src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web",
    "packages/js-sdk",
    "packages/python-sdk",
    "packages/door43/dist"
  ]
}
