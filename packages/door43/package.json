{
  "name": "@translation-helps/door43",
  "version": "0.1.0",
  "private": true,
  "description": "Door43 / DCS catalog client, ZIP resource fetcher, and scripture/helps parsers for Bible translation resources",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./platform": {
      "types": "./src/platform.ts",
      "import": "./src/platform.ts",
      "default": "./src/platform.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "door43",
    "dcs",
    "bible",
    "translation",
    "usfm",
    "unfoldingWord"
  ],
  "author": "unfoldingWord",
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.8",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unfoldingWord/translation-helps-mcp.git",
    "directory": "packages/door43"
  }
}
